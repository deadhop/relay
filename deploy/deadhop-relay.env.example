# deadhop relay settings (see https://deadhop.run/relay/docs/configuration.html)
# Required unless DEADHOP_RELAY_PUBLIC=on: the keys this relay serves. Find them in the deadhop data directory
# (server.pubkey, admin.pubkey) or at the bottom of the dashboard's Overview.
DEADHOP_RELAY_WHITELIST=invoices=npub1...,admin=npub1...
# Or, or as well: carry ContextVM traffic for every key, under public limits.
# DEADHOP_RELAY_PUBLIC=on
DEADHOP_RELAY_PUBLIC_URLS=wss://relay.example.com
DEADHOP_RELAY_TRUSTED_PROXIES=127.0.0.1
# Also on Tor, I2P or FIPS (https://deadhop.run/relay/docs/networks.html):
# DEADHOP_RELAY_TOR_LISTEN=127.0.0.1:7451
# DEADHOP_RELAY_TOR_URLS=ws://….onion
# DEADHOP_RELAY_I2P_LISTEN=127.0.0.1:7452
# DEADHOP_RELAY_I2P_URLS=ws://….b32.i2p
# DEADHOP_RELAY_FIPS_LISTEN=[fd12:…]:7453   # this node's FIPS address
# DEADHOP_RELAY_FIPS_URLS=ws://npub1….fips:7453
